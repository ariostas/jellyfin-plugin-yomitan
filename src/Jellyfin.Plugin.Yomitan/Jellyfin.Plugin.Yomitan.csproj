<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Yomitan</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Yomitan</AssemblyName>
    <!-- VERSION at the root is the one place the version is set. Jellyfin's has four parts. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim()).0</Version>
    <!-- The oldest server it runs on: the packages compiled against, and the manifest's targetAbi. -->
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- The published folder is the release zip, so only what the server needs: the line numbers go inside the DLL, and
         the server needs no dependency file, since everything the plugin uses is its own. -->
    <DebugType>embedded</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ClientBundle>$(MSBuildThisFileDirectory)../../client/dist/client.js</ClientBundle>
    <EngineBundle>$(MSBuildThisFileDirectory)../../client/dist/engine.js</EngineBundle>
    <SettingsPageBundle>$(MSBuildThisFileDirectory)../../client/dist/settings-page.js</SettingsPageBundle>
    <AdminBundle>$(MSBuildThisFileDirectory)../../client/dist/admin.js</AdminBundle>
    <AdminPage>$(MSBuildThisFileDirectory)../../client/src/admin/admin.html</AdminPage>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    All of these ship with the server, so nothing of theirs may end up in the plugin folder. Microsoft.Data.Sqlite is
    only compiled against, and the server's own loads. Its assembly version is the package version, and a server only
    loads a plugin that asks for its own or older, so keep it on what the oldest supported server ships: 10.0.11 in 12.0,
    against 10.0.14 in 12.4. A plugin built against 10.0.14 fails on 12.0 at the first query.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime;native" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ClientBundle)" LogicalName="Jellyfin.Plugin.Yomitan.client.js" />
    <EmbeddedResource Include="$(EngineBundle)" LogicalName="Jellyfin.Plugin.Yomitan.engine.js" />
    <EmbeddedResource Include="$(SettingsPageBundle)" LogicalName="Jellyfin.Plugin.Yomitan.settings-page.js" />
    <EmbeddedResource Include="$(AdminBundle)" LogicalName="Jellyfin.Plugin.Yomitan.admin.js" />
    <EmbeddedResource Include="$(AdminPage)" LogicalName="Jellyfin.Plugin.Yomitan.admin.html" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../third_party/yomitan/ext/data/schemas/dictionary-*-schema.json" LogicalName="Jellyfin.Plugin.Yomitan.schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireClientBundle" BeforeTargets="BeforeBuild" Condition="!Exists('$(ClientBundle)') Or !Exists('$(EngineBundle)') Or !Exists('$(SettingsPageBundle)') Or !Exists('$(AdminBundle)')">
    <Error Text="A bundle in client/dist is missing. Build through scripts/build.sh, which builds the client first." />
  </Target>

  <Target Name="WritePluginManifest" AfterTargets="Publish">
    <PropertyGroup>
      <PluginManifest>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)meta.json.in').Replace('@VERSION@','$(Version)').Replace('@ABI@','$(JellyfinVersion).0'))</PluginManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(PublishDir)meta.json" Lines="$(PluginManifest)" Overwrite="true" />
  </Target>

</Project>
